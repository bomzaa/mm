{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile including study targets, grade level, and streak info",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "gradeLevel": { "type": "string", "maxLength": 50 },
        "dreamFaculty": { "type": "string", "maxLength": 100 },
        "dreamUniversity": { "type": "string", "maxLength": 100 },
        "targetScoreTGAT": { "type": "number" },
        "targetScoreTPAT": { "type": "number" },
        "targetScoreALevel": { "type": "number" },
        "dailyGoalQuestions": { "type": "number" },
        "streakDays": { "type": "number" },
        "joinedDate": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "email", "gradeLevel", "dreamFaculty", "dreamUniversity"]
    },
    "ExamHistory": {
      "title": "ExamHistory",
      "description": "Record of a completed exam attempt",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "examId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 100 },
        "difficulty": { "type": "string", "maxLength": 50 },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "timeSpentSeconds": { "type": "number" },
        "completedAt": { "type": "string", "maxLength": 50 },
        "questions": { "type": "array" }
      },
      "required": ["id", "userId", "examId", "title", "category", "subject", "score", "totalQuestions", "percentage", "completedAt"]
    },
    "CustomExam": {
      "title": "CustomExam",
      "description": "AI-generated exam or custom practice test set",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 100 },
        "topic": { "type": "string", "maxLength": 100 },
        "difficulty": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "timeLimitMinutes": { "type": "number" },
        "questions": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "title", "category", "subject", "difficulty", "timeLimitMinutes", "questions", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Chat interaction message between user and AI tutor",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "model"], "maxLength": 20 },
        "content": { "type": "string", "maxLength": 10000 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "suggestedQuestions": { "type": "array" },
        "category": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "userId", "role", "content", "timestamp"]
    },
    "AnalysisReport": {
      "title": "AnalysisReport",
      "description": "AI-generated performance analysis report",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "readinessScore": { "type": "number" },
        "estimatedPercentile": { "type": "string", "maxLength": 50 },
        "overview": { "type": "string", "maxLength": 2000 },
        "targetFacultyFeedback": { "type": "string", "maxLength": 2000 },
        "strengths": { "type": "array" },
        "weaknesses": { "type": "array" },
        "weeklyPlan": { "type": "array" },
        "tips": { "type": "array" },
        "analyzedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "readinessScore", "estimatedPercentile", "overview", "analyzedAt"]
    },
    "OfficialExam": {
      "title": "OfficialExam",
      "description": "Standardized official exam archive and question bank such as TPAT3 ธ.ค. 66",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 100 },
        "examCode": { "type": "string", "maxLength": 50 },
        "term": { "type": "string", "maxLength": 50 },
        "year": { "type": "string", "maxLength": 50 },
        "timeLimitMinutes": { "type": "number" },
        "difficulty": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 1000 },
        "questions": { "type": "array" },
        "totalQuestions": { "type": "number" },
        "isOfficial": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "category", "subject", "questions", "createdAt"]
    },
    "ExamPreparationItem": {
      "title": "ExamPreparationItem",
      "description": "Curated/admin-imported standardized real exam sets for exam preparation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "examType": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 150 },
        "year": { "type": "string", "maxLength": 50 },
        "term": { "type": "string", "maxLength": 50 },
        "topic": { "type": "string", "maxLength": 200 },
        "difficulty": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 1000 },
        "timeLimitMinutes": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "questions": { "type": "array" },
        "isOfficial": { "type": "boolean" },
        "importedBy": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "examType", "subject", "year", "questions", "createdAt"]
    },
    "AiPracticeExam": {
      "title": "AiPracticeExam",
      "description": "AI-generated practice exams for topic review and student practice",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "subject": { "type": "string", "maxLength": 150 },
        "gradeLevel": { "type": "string", "maxLength": 50 },
        "topic": { "type": "string", "maxLength": 200 },
        "subtopic": { "type": "string", "maxLength": 200 },
        "difficulty": { "type": "string", "maxLength": 50 },
        "questionFormat": { "type": "string", "maxLength": 50 },
        "timeLimitMinutes": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "questions": { "type": "array" },
        "isAiGenerated": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "title", "subject", "questions", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with study goals and target scores"
    },
    "/users/{userId}/examHistory/{historyId}": {
      "schema": "ExamHistory",
      "description": "Completed mock test attempts and scores"
    },
    "/users/{userId}/customExams/{examId}": {
      "schema": "CustomExam",
      "description": "Generated or saved exams for practice"
    },
    "/users/{userId}/chatMessages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Chat history with AI tutor"
    },
    "/users/{userId}/analysisReports/{reportId}": {
      "schema": "AnalysisReport",
      "description": "AI analysis reports on exam performance"
    },
    "/officialExams/{examId}": {
      "schema": "OfficialExam",
      "description": "Official shared exam bank and historical standardized tests"
    },
    "/exams/exam_preparation/items/{examId}": {
      "schema": "ExamPreparationItem",
      "description": "Admin-curated standardized exam sets categorized by subject, exam type, year and topic"
    },
    "/exams/ai_practice/items/{examId}": {
      "schema": "AiPracticeExam",
      "description": "AI-generated practice exams for topic-based training"
    }
  }
}
